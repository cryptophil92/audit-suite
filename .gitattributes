* text=auto

*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
VERSION text eol=lf

# Runtime audit data may contain environment-specific or sensitive details.
# Keep cleanup commits reviewable without rendering removed artifact contents.
logs/** -diff
output/** -diff
tmp/** -diff
history/** -diff
